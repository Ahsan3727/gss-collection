# ─── MongoDB Atlas Connection ──────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gss_collection?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gss_collection?retryWrites=true&w=majority

# ─── NextAuth & Security ───────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme_random_32_characters_secret_key_123
JWT_SECRET=changeme_random_jwt_secret_key_123
JWT_REFRESH_SECRET=changeme_random_jwt_refresh_secret_key_123

# ─── Admin Account Setup ───────────────────────
ADMIN_EMAIL=admin@gsscollection.com
ADMIN_PASSWORD=admin123

# ─── Cloudinary Image Storage ──────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Upstash Redis (Optional for Rate Limiting) ─
REDIS_URL=rediss://default:your_token@your_host.upstash.io:6379
