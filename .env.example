# ─── MongoDB Atlas Connection ──────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gss_collection?retryWrites=true&w=majority

# ─── NextAuth & Security ───────────────────────
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=replace_with_a_long_random_string

# ─── Admin Account Setup ───────────────────────
# Used only for the first login, while no admin user exists yet.
# Remove ADMIN_PASSWORD from Vercel after that login succeeds.
ADMIN_EMAIL=admin@gsscollection.com
ADMIN_PASSWORD=replace_with_a_strong_password

# ─── Cloudinary Image Storage ──────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Error Monitoring (Optional Sentry DSN) ────
# SENTRY_DSN=https://key@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
